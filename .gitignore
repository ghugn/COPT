# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
env/
ENV/

# Exclude PDF files (do not upload paper PDF)
*.pdf

# Datasets & generated graph cache (only root /data/)
/data/
!configs/data/
!src/data/
!data/ba/small/processed/**
!data/rb/small/processed/**


# Compressed archives
*.zip
*.tar
*.gz
*.rar

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
~$*
~$*.docx

# Experiment trackers & temporary logs
wandb/
.pytest_cache/
.coverage
htmlcov/

# Logs handling:
# Ignore transient run logs and debugging outputs
logs/train/runs/
logs/eval/
logs/debug/

# EXPLICITLY INCLUDE trained model checkpoints (.ckpt)
!logs/train/checkpoints/
!logs/train/checkpoints/**
!*.ckpt
